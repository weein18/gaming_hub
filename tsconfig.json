{
  "compilerOptions": {
    "lib": ["ES2021", "DOM"],
    "target": "ES2020",
    "module": "ESNext",
    "rootDir": "static/ts",
    "outDir": "static/js",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": [
    "static/ts/**/*.ts"
  ]
}